<resources>

    <!-- Base application theme for API 21+ -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="AppTheme.Recording" parent="AppTheme">
        <item name="colorPrimary">@color/colorPrimaryRecording</item>
        <item name="colorPrimaryDark">@color/colorPrimaryRecording</item>
        <item name="android:statusBarColor">@color/colorPrimaryRecording</item>
    </style>

</resources>